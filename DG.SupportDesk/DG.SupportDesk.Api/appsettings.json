{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=dg_support_desk_db;Username=postgres;Password=postgrespass123;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Datadog.Logs",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Process",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} [IP:{ClientIp} Port:{ClientPort} UserAgent:{UserAgent} RequestedHost:{RequestedHost} CorrelationId:{CorrelationId}]{NewLine}{Exception}"
        }
      },
      {
        "Name": "DatadogLogs",
        "Args": {
          "apiKey": "ac4e8ceb038e9181a24a7409b802cbc2",
          "source": "dotnet",
          "service": "dg-support-service-dev",
          "host": "dg-supportdesk-dev",
          "tags": [
            "env:production",
            "team:platform",
            "app:dg-supportdesk"
          ],
          "configuration": {
            "url": "https://http-intake.logs.us5.datadoghq.com"
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithProcessId",
      "WithProcessName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "DG.SupportDesk.API"
    }
  }
}
